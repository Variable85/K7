<div class="tv-hero">
    <div class="tv-back-button">
        <K7Button StartIcon="@Phosphor.ArrowLeft"
                   Color="secondary"
                   Variant="filled"
                   Href="@($"/series/{SerieId}")">
            @L["BackToSerie"]
        </K7Button>
    </div>

    <div class="tv-details">
        <K7Image Class="tv-logo"
                 ObjectFit="scale-down"
                 Src="@LogoUrl"
                 Alt="">
            <FallbackContent>
                <h3 class="media-logo-title">@SerieTitle?.ToUpper()</h3>
            </FallbackContent>
        </K7Image>

        <div class="tv-episode-info">
            @if (_episode is not null)
            {
                <span class="tv-episode-label">
                    @string.Format(L["EpisodeNumber"], _episode.EpisodeNumber)
                </span>
                <h3 class="tv-episode-title">@_episode.Title</h3>

                @if (AirDateLabel is not null || DurationLabel is not null || RatingLabel is not null)
                {
                    <div class="tv-episode-meta">
                        @if (RatingLabel is not null)
                        {
                            <K7Chip Class="tv-episode-rating"
                                    Size="sm"
                                    Icon="star"
                                    Color="primary"
                                    Variant="filled"
                                    Style="font-weight: 700;">
                                @RatingLabel
                            </K7Chip>
                        }
                        @if (AirDateLabel is not null || DurationLabel is not null)
                        {
                            <div class="tv-episode-details">
                                @if (AirDateLabel is not null)
                                {
                                    <span class="tv-episode-date text-sm">@AirDateLabel</span>
                                }
                                @if (AirDateLabel is not null && DurationLabel is not null)
                                {
                                    <span class="tv-episode-meta-sep text-sm" aria-hidden="true">&bull;</span>
                                }
                                @if (DurationLabel is not null)
                                {
                                    <span class="tv-episode-duration text-sm">@DurationLabel</span>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="tv-episode-overview overview-clickable focusable" tabindex="0" role="button" @onclick="OpenSynopsisAsync">
                    <p>@(_episode.Overview ?? "")</p>
                </div>
            }

            @if (CanRestartEpisode && _episode is { } resumeEpisode)
            {
                <div class="tv-episode-actions">
                    <div class="tv-episode-actions-primary tv-episode-actions-primary--split">
                        <K7Button Variant="filled"
                                   StartIcon="@Phosphor.Play"
                                   Color="primary"
                                   Size="lg"
                                   Class="tv-episode-actions-play"
                                   OnClick="() => PlayAsync(resumeEpisode, fromBeginning: false)">
                            @PlayLabel
                        </K7Button>
                        <K7Button Variant="outlined"
                                   StartIcon="@Phosphor.ClockCounterClockwise"
                                   Color="primary"
                                   Size="lg"
                                   Class="tv-episode-actions-replay"
                                   AriaLabel="@S["PlayFromBeginning"]"
                                   OnClick="() => PlayAsync(resumeEpisode, fromBeginning: true)" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>
